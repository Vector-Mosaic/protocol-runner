# Optional live Windows Desktop profile. Copy to .env.desktop.local.
# Start: pnpm desktop -- --workspace C:\work\my-project
# Required: installed Codex CLI, your own secrets and private Discord IDs.
# The launcher sets both services' allowed workspace from --workspace.
CODEX_CLI_PATH=
WORKSTATION_CONTROL_CODEX_DESKTOP_HOST=127.0.0.1
WORKSTATION_CONTROL_CODEX_DESKTOP_PORT=14825
WORKSTATION_CONTROL_CODEX_DESKTOP_BEARER_TOKEN=
WORKSTATION_CONTROL_CODEX_DESKTOP_OPERATOR_GATE_ATTENTION_ENABLED=false
WORKSTATION_CONTROL_CODEX_DESKTOP_OPERATOR_GATE_AUTO_ALLOW_MS=15000
WORKSTATION_CONTROL_CODEX_DESKTOP_OPERATOR_GATE_ATTENTION_URL=http://127.0.0.1:15174/?gate=1
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_HOST=127.0.0.1
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_PORT=14830
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_DESKTOP_ADAPTER_MODE=api
# Relay-to-Desktop authentication reuses WORKSTATION_CONTROL_CODEX_DESKTOP_BEARER_TOKEN.
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_PUBLISH_BEARER_TOKEN=
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_OPERATOR_ENABLED=true
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_OPERATOR_BEARER_TOKEN=
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_ORCHESTRATION_ENABLED=false
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_BOT_TOKEN=
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_GUILD_ID=
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_COMMAND_CHANNEL_ID=
# Optional category ID; leave empty to use the server's default placement.
WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_TEXT_CHANNEL_PARENT_ID=
PROTOCOL_RUNNER_API_PORT=14831
PROTOCOL_RUNNER_UI_PORT=15174
# The launcher selects real adapters and sets all local backend URLs.
# Same secret as WORKSTATION_CONTROL_CODEX_DESKTOP_BEARER_TOKEN.
PROTOCOL_RUNNER_CODEX_DESKTOP_BEARER_TOKEN=
# Same secret as WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_PUBLISH_BEARER_TOKEN.
PROTOCOL_RUNNER_DISCORD_RELAY_PUBLISH_BEARER_TOKEN=
# Same secret as WORKSTATION_CONTROL_DISCORD_DESKTOP_RELAY_OPERATOR_BEARER_TOKEN.
PROTOCOL_RUNNER_DISCORD_RELAY_OPERATOR_BEARER_TOKEN=
# Optional: leave empty for a generated local Runner control token.
# If supplied, use another independent secret of at least 32 characters.
PROTOCOL_RUNNER_CONTROL_TOKEN=
